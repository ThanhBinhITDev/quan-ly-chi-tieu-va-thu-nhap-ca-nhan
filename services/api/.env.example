# Cấu hình API Student Finance.
# Sao chép file này thành `.env` rồi điền giá trị thật. `.env` bị gitignore.

# --- Database ---
# Local: postgresql://<user>@127.0.0.1:5432/student_finance
# Supabase: chuỗi Session pooler lấy ở Project Settings → Database
DATABASE_URL=postgresql://postgres@127.0.0.1:5432/student_finance
DATABASE_SSL=false
DATABASE_POOL_MAX=5

# --- Xác thực ---
# Production: đặt SUPABASE_URL để verify JWT qua JWKS (không cần secret).
# Local/self-host: đặt SUPABASE_JWT_SECRET (HS256) và tự ký token khi test.
# Thiếu cả hai thì API từ chối mọi token — không có chế độ bỏ qua chữ ký.
SUPABASE_URL=
SUPABASE_JWT_SECRET=

# --- HTTP ---
PORT=3000
# 127.0.0.1 khi chạy sau reverse proxy; 0.0.0.0 khi cần emulator/container gọi vào.
HOST=127.0.0.1
# Danh sách origin được phép, cách nhau bằng dấu phẩy. Để trống = tắt CORS.
CORS_ORIGINS=

# --- Giới hạn tải ---
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=60