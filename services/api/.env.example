# Sao chép thành .env rồi điền giá trị thật. KHÔNG commit .env.

# Postgres của Supabase (dùng chung cho API và worker)
DATABASE_URL=postgresql://postgres.<project_ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_SSL=true
DATABASE_SSL_STRICT=false
DATABASE_POOL_MAX=10

# Xác thực JWT do Supabase Auth phát hành
SUPABASE_URL=https://<project_ref>.supabase.co
# Chỉ dùng khi self-host hoặc test cục bộ
# SUPABASE_JWT_SECRET=

PORT=3000
